{
    "name": "hamada-emam-tech/einvoice-monorepo",
    "description": "Monorepo for hamada-emam-tech/einvoice and its tax-authority and key-source packages. Each folder in packages/ is split into its own read-only repo and published on Packagist.",
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "ext-openssl": "*",
        "ext-dom": "*",
        "ext-xmlwriter": "*",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^1.10",
        "guzzlehttp/guzzle": "^7.8"
    },
    "autoload": {
        "psr-4": {
            "HamadaEmamTech\\Einvoice\\": "packages/einvoice/src/",
            "HamadaEmamTech\\Einvoice\\Zatca\\": "packages/einvoice-zatca/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HamadaEmamTech\\Einvoice\\Tests\\": "packages/einvoice/tests/",
            "HamadaEmamTech\\Einvoice\\Zatca\\Tests\\": "packages/einvoice-zatca/tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --level=8 packages"
    },
    "config": {
        "sort-packages": true
    }
}
